# ChainDrop-class supply-chain attacks execute during `npm install` via a
# preinstall hook, before any audit or review step can intervene. No dependency
# in this project needs an install script, so refuse to run any.
#
# This does not affect `npm run <script>`, which still runs its named script;
# it blocks install lifecycle scripts and pre/post hooks, and this project
# defines no pre*/post* hooks. The only dependency with an install script is
# fsevents (optional, darwin-only), which CI never installs on ubuntu-latest.
ignore-scripts=true
